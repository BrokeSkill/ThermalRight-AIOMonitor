<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FrostPanel.Gui</RootNamespace>
    <AssemblyName>FrostPanel</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FrostPanel.App/FrostPanel.App.csproj" />
    <ProjectReference Include="../FrostPanel.Capture/FrostPanel.Capture.csproj" />
    <ProjectReference Include="../FrostPanel.Core/FrostPanel.Core.csproj" />
    <ProjectReference Include="../FrostPanel.Transport/FrostPanel.Transport.csproj" />
  </ItemGroup>
</Project>
